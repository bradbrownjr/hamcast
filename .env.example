# Copy to .env. Empty values fall back to config.yaml, then the defaults.
HAMCAST_CALLSIGN=N0CALL
HAMCAST_DMR_ID=
# Password for the web app's Manage pages. Empty = generated into
# data/admin-password.txt on first start.
HAMCAST_ADMIN_PASSWORD=

# Empty = bundled Icecast. Or: icecast://source:PASSWORD@host:8000
HAMCAST_ICECAST_URL=
HAMCAST_PUBLIC_URL=
ICECAST_SOURCE_PASSWORD=
ICECAST_ADMIN_PASSWORD=

HAMCAST_TRANSCRIBE=false
# Empty = built-in Whisper. Or any OpenAI-compatible server: http://host:9000
HAMCAST_STT_URL=
HAMCAST_STT_MODEL=small.en
HAMCAST_STT_API_KEY=

PUID=1000
PGID=1000
TZ=America/New_York

# Host ports for docker-compose (inside the container they stay 8080 /
# 8000). If ICECAST_HOST_PORT isn't 8000, set HAMCAST_PUBLIC_URL to
# http://this-host:ICECAST_HOST_PORT so the dashboard's players work.
DASHBOARD_HOST_PORT=8080
ICECAST_HOST_PORT=8000
